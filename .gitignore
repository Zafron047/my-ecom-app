!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.headless-edge/

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem
/public/uploads/
/.tmp-redx-area-data/
