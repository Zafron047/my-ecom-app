DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_ecom_app?schema=public"
PRISMA_PG_POOL_MAX="2"

# Supabase Storage for product media uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Optional for local bypass during development only.
ADMIN_DEV_ROLE=""

# Admin reset links default to 60 minutes when unset.
ADMIN_PASSWORD_RESET_TTL_MINUTES="60"

# Bootstrap admin seed values.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PHONE=""
ADMIN_SEED_PASSWORD="change-this-password"
ADMIN_SEED_NAME="Shop Admin"
ADMIN_SEED_ROLE="admin"
