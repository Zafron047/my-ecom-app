DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bdbuyeasy_webapp?schema=public"
PRISMA_PG_POOL_MAX="2"
NEXT_ALLOWED_DEV_ORIGINS="192.168.0.106"

# Supabase Storage for product media uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Optional for local bypass during development only.
ADMIN_DEV_ROLE=""

# Admin reset links default to 60 minutes when unset.
ADMIN_PASSWORD_RESET_TTL_MINUTES="60"

# Bootstrap admin seed values.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PHONE=""
ADMIN_SEED_PASSWORD="change-this-password"
ADMIN_SEED_NAME="Shop Admin"
ADMIN_SEED_ROLE="admin"

# Customer Google/Facebook sign-in.
NEXT_PUBLIC_SITE_URL="https://bdbuyeasy.com"
NEXT_PUBLIC_APP_URL="https://bdbuyeasy.com"
CUSTOMER_OAUTH_STATE_SECRET="change-this-oauth-state-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_API_VERSION="v20.0"

# WoWMall partner API. Required because responses include cost and exact inventory.
# WoWMall must send X-WoWMall-Api-Key with this value.
WOWMALL_STOREFRONT_API_KEY=""
WOWMALL_ALLOWED_ORIGINS="https://wowmall.xyz,https://www.wowmall.xyz"

# Meta Pixel + Conversions API.
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_CAPI_API_VERSION="v25.0"
META_TEST_EVENT_CODE=""

# Password reset email delivery (Resend HTTP API).
RESEND_API_KEY=""
MAIL_FROM="BDBuyEasy <no-reply@bdbuyeasy.com>"
